APP_NAME="HealthData Talent UK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Europe/London

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite works out of the box. For MySQL (e.g. XAMPP) or PostgreSQL, change
# DB_CONNECTION and uncomment the lines below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=healthdata_talent
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set to true in production (requires HTTPS).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@healthdatatalent.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# --- HealthData Talent settings ---
HDT_CONTACT_EMAIL=info@healthdatatalent.co.uk
# Staff must enrol an authenticator app. Leave true anywhere real data is held.
HDT_REQUIRE_2FA=true
# Candidate profiles are deleted this many months after last contact.
HDT_RETENTION_MONTHS=24
# Full path to clamscan to malware-scan uploaded CVs, e.g. /usr/bin/clamscan
HDT_CLAMAV_PATH=

# First admin account, created by `php artisan db:seed`.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed once.
ADMIN_EMAIL=admin@healthdatatalent.co.uk
ADMIN_PASSWORD=
